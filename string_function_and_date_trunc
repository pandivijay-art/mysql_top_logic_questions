--1.Find total revenue per month from the orders table. 
select date_trunc(order_date,month) ,sum(amount) as total_revenue from Orders12 where status="DELIVERED" group by date_trunc(order_date,month);

--2.Strings Functions.

--1.Lower() - it is Convert tha all charcters to Lower Case.
select * from Orders12 where lower(status)="delivered";
--2.Upper() - it is convert tha all charcters into upper Case.
select upper(status) as capes from Orders12;
--3.trim() - it is used to remove extra spaces from stating and ending
select *  from Orders12 where trim(status)="DELIVERED";
--4.concat() - combine two or more strings.
select *,concat(status,customer_id) as co_word from Orders12 ;
--5.Len() - return the Number of Charcters in string.
select length(status) from Orders12
--6.subset() - extract the specific part of the string based on the position .
select subset("satheesh",1,5) from Orders12
--7.replace() - replace the text or Value with a another text Value
select replace(status,'DELIVERED','DELIVERY') FROM Orders12;
--spilt  - devide a strimng into multiple Parts
elect split("DELIVER-Y",'-') from Orders12
