--1.Write a query to display each employee's previous month's salary using the LAG() function.
select salary,Month_Name,lag(salary) over(order by salary) as previous_salary from employee_salary 

--2.diff between the current month salary and previos month sal,ary
select Month_Name,Salary ,salary -lag(salary) over(order by salary) as difference from employee_salary;

--3.Write a query to compare the current month's salary with the previous month's salary and display:
--Increased if the salary increased
---Decreased if the salary decreased
--NULL for the first month

select month_name,salary,lag(salary) over(order by salary) as previous,
case
when salary > lag(salary) over(order by salary) then "Increased"
when salary < lag(salary) over(order by salary) then "Decresed"
when lag(salary) over(order by salary) is null then "null"
end as final_result

from employee_salary;



--4.Display the previous month’s salary for each employee within their department using LAG() and PARTITION BY.

select Department,Month_Name,Salary,lag(salary) over(partition by department order by salary) ,case
when salary > lag(salary) over(partition by department order by salary) then "Increase"
when salary < lag(salary) over(partition by department order by salary) then "Decrease"
when salary is null then "Null"
end as differnce
from employee_salary

--5.Calculate the percentage change in salary compared with the previous month using LAG().
select month_name,salary,lag(salary) over(order by Emp_id),(salary-lag(salary) over(order by Emp_id))/(lag(salary) over(order by Emp_id) *1.0)* 100 from employee_salary

