-- 1.Create a view named it_employees that displays the emp_id, name, salary, and age of all employees who belong to the IT department. Then retrieve the data from the view.
create view it_employees as select emp_id,name,salary from Employees where department = "IT"
select * from it_employees

-- 2.Create a view named high_salary_employees that displays the employee name, department, salary, and age of employees whose salary is ₹60,000 or above. Then use the view to display the employees in descending order of salary.
create view highest_salary1 as select name,department,salary,age from Employees  where salary >= 60000 order by salary desc;

