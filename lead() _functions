select Employee,Month_Name,	Salary,lead(salary,1,0) over(order by emp_id) ,
case
when lead(salary,1,0) over(order by emp_id)= 0 then "No Next Employees"
when Salary<lead(salary,1,0) over(order by emp_id)  then "Increased"
when Salary>lead(salary,1,0) over(order by emp_id)  then "Decreased"

end as status_for_employees from Employee_Salary  */

--3.Using the Employee_Salary table, calculate the percentage salary change from the current month to the next month for each department. The calculation must stay within each department, and the last month.
select Employee,Month_Name,	Salary,lead(salary) over( partition by department order by emp_id) as next_month,(
lead(salary) over( partition by department order by salary)-Salary)/(Salary * 1.0) * 100 from Employee_Salary

