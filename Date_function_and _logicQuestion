--2.Find the customers who have placed orders, but whose latest order was NOT delivered
select * from customers_max a left join orders_max b on a.customer_id=b.customer_id 
where b.order_date=(
select max(b2.order_date) from orders_max b2
where b2.customer_id = b.customer_id) and b.status <> "DELIVERED"
