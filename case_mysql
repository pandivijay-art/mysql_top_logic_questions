--2.Write a SQL query to display each employee’s name, department, and salary category based on the following company rules:
--Employees with salary ₹1,00,000 or above → Excellent
--Employees with salary ₹80,000 or above → Good
--Employees with salary ₹50,000 or above → Average
--Employees below ₹50,000 → Below Average

select emp_name,department,salary,
case
    when salary>=100000 then "Excellent"
    when salary>=80000 then "Good"
    when salary>=50000 then "Average"
    else "Below Average"
end as status
from Employees
