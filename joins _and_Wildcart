--1. Display the city name and country Name for every Location
select a.city,b.country_name from Locations a inner join Countries b on a.country_id = b.country_id

--2.Display the location Id,city, and country name for locations belonging to india ,japan and germany
 select a.location_id,a.city,b.country_name	 from Locations a inner join Countries b on a.country_id = b.country_id where b.country_name ="India" or b.country_name ="Japan" or b.country_name ="Germany"

 -- 3.Display All locations whose location id is betweeen 1200 and 2500
