--create Table 

CREATE TABLE employees (
    employee_id INT PRIMARY KEY,
    name VARCHAR(50),
    first_name VARCHAR(50),
    salary INT,
    department_id INT,
    manager_id INT,
    join_date DATE,
    birth_date DATE,
    job_title VARCHAR(50),
    email VARCHAR(100),
    bonus INT
);
